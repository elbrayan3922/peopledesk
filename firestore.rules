rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Roles ────────────────────────────────────────────────────────────────────
    // isSuper: administradores principales, escritos aquí (siempre funcionan y no se pueden bloquear).
    //          Escribe los correos en minúsculas; puedes poner varios separados por coma.
    // Los demás accesos se gestionan desde el panel (Administración → Accesos y roles) en la colección staff:
    //   admin    → todo
    //   rrhh     → empleados, permisos, asistencia manual, horarios y planilla
    //   consulta → solo lectura
    function signedIn() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email_verified == true;
    }
    function isSuper() {
      return signedIn()
          && request.auth.token.email in ['REEMPLAZA_CON_TU_CORREO_DE_GOOGLE@gmail.com'];
    }
    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.token.email.lower());
    }
    function staffRole() {
      return signedIn() && exists(staffPath()) && get(staffPath()).data.active == true
          ? get(staffPath()).data.role : '';
    }
    function isAdmin()  { return isSuper() || staffRole() == 'admin'; }
    function isHR()     { return isAdmin() || staffRole() == 'rrhh'; }
    function isViewer() { return isHR() || staffRole() == 'consulta'; }

    // ── Registro hecho desde la terminal pública con un QR válido ───────────────
    // Además de las comprobaciones de siempre, exige que la hora enviada (ts) esté a menos de 10 minutos
    // de la hora real del servidor: un reloj mal puesto o manipulado no puede registrar a otra hora.
    function validScan(id) {
      let d = request.resource.data;
      let t = get(/databases/$(database)/documents/qrTokens/$(d.qrToken)).data;
      return d.keys().hasOnly(['employeeId','code','name','position','department',
                               'date','time','method','punctuality','type','qrToken','createdAt','ts','shiftId'])
          && d.method == 'qr'
          && d.createdAt == request.time
          && d.ts is int
          && math.abs(d.ts - request.time.toMillis()) < 600000
          && (!('shiftId' in d) || d.shiftId is string)
          && d.employeeId == t.employeeId
          && t.status != 'Inactivo'
          && (id == d.employeeId + '_' + d.date
              || id == d.employeeId + '_' + d.date + '_salida');
    }

    // Empleados: nunca se borran (se marcan Inactivo) y el qrToken, una vez creado, no puede cambiar:
    // así las tarjetas QR impresas siguen funcionando siempre.
    match /employees/{id} {
      allow read: if isViewer();
      allow create: if isHR();
      allow update: if isHR()
        && (!('qrToken' in resource.data) || request.resource.data.qrToken == resource.data.qrToken);
      allow delete: if false;
    }

    match /permissions/{id} { allow read: if isViewer(); allow write: if isHR(); }

    // Copia mínima del empleado indexada por token QR. Solo se puede leer UN documento
    // si conoces su token (que es aleatorio); no se puede listar. Nunca se borra.
    match /qrTokens/{token} {
      allow get: if true;
      allow list: if isViewer();
      allow create, update: if isHR();
      allow delete: if false;
    }

    match /attendance/{id} {
      allow get: if true;                        // la terminal comprueba duplicados (ids no adivinables)
      allow list: if isViewer();
      allow update, delete: if isHR();           // solo RR. HH. / admin pueden corregir
      allow create: if isHR() || validScan(id);
    }

    // Horarios y turnos: la terminal pública los lee; escribe RR. HH.
    match /settings/schedule {
      allow get: if true;
      allow write: if isHR();
    }
    // Parámetros de planilla y privacidad, y metadatos de respaldo.
    match /settings/{id} {
      allow read: if isViewer();
      allow write: if isAdmin();
    }

    // Accesos y roles: cada persona puede leer su propio rol; solo el admin lista y modifica.
    match /staff/{email} {
      allow get: if signedIn() && request.auth.token.email.lower() == email;
      allow get, list, write: if isAdmin();
    }

    // Bitácora: se puede crear (a nombre propio) pero jamás editar ni borrar.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isViewer()
        && request.resource.data.keys().hasOnly(['at','ts','actor','role','action','target','detail'])
        && request.resource.data.actor == request.auth.token.email.lower()
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Consentimientos de biometría.
    match /consents/{id} {
      allow read: if isViewer();
      allow create, update: if isHR();
      allow delete: if false;
    }
  }
}
